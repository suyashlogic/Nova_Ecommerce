# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
PG_USER=postgres
PG_HOST=localhost
PG_DATABASE=nova_db
PG_PASSWORD=your_password_here
PG_PORT=5432

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Cookies
COOKIE_NAME=nova_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Uploads
MAX_UPLOAD_MB=2